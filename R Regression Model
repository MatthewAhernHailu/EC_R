```{r}
###
# 3.  Prepare data for modelling 
##

volvo <- volvo %>% mutate(across(where(is.character), as.factor))
volvo$log_price <- log(volvo$Försäljningspris)

set.seed(123)
id      <- sample(nrow(volvo), 0.8 * nrow(volvo))
train   <- volvo[id, ]
test    <- volvo[-id, ]

## drop constant predictors and obvious non-features
train <- train %>%
           select(where(~ n_distinct(.) > 1)) %>% 
           select(-Index, -Försäljningspris, -Färg)   # I removed Färg

## mirror same columns in test and align factor levels
test_x <- test[ , names(train)]
faccols <- names(train)[sapply(train, is.factor)]
for (cl in faccols) {
  test_x[[cl]] <- factor(test_x[[cl]], levels = levels(train[[cl]]))
}

####
# 4.  Fit multiple linear regression -

fit <- lm(log_price ~ ., data = train)
coef_tbl <- tidy(fit, conf.int = TRUE) %>%          
  mutate(pct_change = round((exp(estimate) - 1) * 100, 1)) %>%  
  select(term, estimate, std.error, conf.low, conf.high,
         pct_change, p.value)
```

```{r}
kable(coef_tbl, digits = 3,
      caption = "Regression coefficients, 95% CI and % change in price")

##  Model-level summary (R², RMSE on train set, etc.)
model_tbl <- glance(fit) %>% 
  select(r.squared, adj.r.squared, sigma, AIC, BIC) %>% 
  rename(`R²` = r.squared,
         `Adj R²` = adj.r.squared,
         `Residual SD` = sigma)

kable(model_tbl, digits = 3,
      caption = "Overall model diagnostics")          
```

```{r}
####
# 5.  Diagnostics 

par(mfrow = c(1, 2))
plot(fit, which = 1)   
plot(fit, which = 2)   


# 6.  Predict and evaluate (transform back logresp)

pred  <- exp(predict(fit, newdata = test_x))          
rmse  <- sqrt(mean((pred - test$Försäljningspris)^2))
print(rmse)                                           
```

