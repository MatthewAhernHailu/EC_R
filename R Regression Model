library(tidyverse)   
library(readxl)      
library(ggcorrplot)  
library(broom)    
library(knitr)    
library(dplyr)

volvo <- read_excel("C:/Users/ahern/Downloads/data_insamling_volvo_blocket.xlsx")

####
# 1.  Data cleaning  

## numeric parsing
volvo$Motorstorlek <- as.numeric(volvo$Motorstorlek)
volvo$Hästkrafter  <- as.numeric(volvo$Hästkrafter) # 
volvo$Miltal       <- as.numeric(volvo$Miltal)

## made new helper columns
volvo$brand_new <- ifelse(volvo$Miltal == 0, 1, 0)
volvo$age       <- ifelse(volvo$brand_new == 1, 0, 2025 - volvo$Modellår)

## NA fixes
volvo$Motorstorlek[is.na(volvo$Motorstorlek) & volvo$Bränsle == "EL"] <- 0
volvo$Motorstorlek[is.na(volvo$Motorstorlek)] <-
  median(volvo$Motorstorlek, na.rm = TRUE)

volvo$Hästkrafter[is.na(volvo$Hästkrafter)] <-
  median(volvo$Hästkrafter, na.rm = TRUE)

for (col in c("Säljare","Växellåda","Biltyp","Drivning",
              "Färg","Märke","Modell")) {
  volvo[[col]][is.na(volvo[[col]])] <- "Unknown"
}
volvo$Datum_i_trafik <- NULL           
```

